@echo off
chcp 65001 >nul
title Расписание "Под ключ" - Сервер и Telegram Бот
cd /d "%~dp0bot"

echo ======================================================================
echo    Запуск Сервера и Telegram Бота (Кросс-девайс синхронизация)
echo ======================================================================
echo.

node server.js

if errorlevel 1 (
    echo.
    echo [ОШИБКА] Не удалось запустить сервер. Убедитесь, что установлен Node.js.
    pause
)
