# Токен вашего Телеграм-бота, полученный от @BotFather
TELEGRAM_BOT_TOKEN=

# Порт для локального сервера (по умолчанию 3000)
PORT=3000

# (Опционально) Бесплатный ключ Google Gemini API для распознавания голосовых сообщений и авто-генерации расписания
# Получить за 1 минуту: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# (Опционально) Публичный HTTPS URL (ngrok, Cloudflare Tunnel или Render),
# если вы хотите открывать красивый веб-интерфейс прямо внутри Телеграма как Mini App
APP_URL=
